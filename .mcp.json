{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "mymcp": {
      "type": "stdio",
      "command": "python",
      "args": [
        "mcp_server/workspace_server.py"
      ],
      "env": {}
    }
  }
}